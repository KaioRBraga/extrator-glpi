# ── GLPI ──────────────────────────────────────────────────────────────────────
# Todas as variaveis desta secao sao OBRIGATORIAS.
# O servico NAO sobe se qualquer uma faltar (sem fallback, conforme o SDD).
GLPI_URL=https://glpi.suaempresa.com.br
GLPI_APP_TOKEN=
GLPI_USUARIO=
GLPI_SENHA=

# ── TLS (obrigatorio: o servico e exclusivamente HTTPS) ───────────────────────
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key

# ── Opcionais ─────────────────────────────────────────────────────────────────
SERVER_PORT=8443
# false = nao valida o certificado do GLPI (util com CA interna)
GLPI_VERIFY_SSL=true
# rotulos do formulario usados como "Motivo de abertura", em ordem de prioridade
MOTIVO_ABERTURA_LABELS=SOLICITACAO,PROBLEMA,ATENDIMENTO,MOTIVO
# rotulos do formulario que contem o login alvo ("Usuario de rede")
USUARIO_REDE_LABELS=USUARIO DE REDE,LOGIN DE REDE,USUARIO,LOGIN,USER
# consultas simultaneas ao GLPI na busca de encerramento (mais rapido, mais carga)
GLPI_PARALELISMO=20
# chamados por pagina da busca. 1000 e o teto: acima disso o GLPI da Motiva
# devolve HTTP 500. Se o seu servidor recusar, o servico reduz sozinho.
GLPI_LOTE_BUSCA=1000
# mantem o mes corrente sempre pronto no cache, em segundo plano.
# false = cada periodo e varrido so quando alguem pede (primeira consulta lenta)
AQUECER_CACHE=true
# tempo de vida do cache de consultas ao GLPI
CACHE_TTL=30m
# tempo maximo de uma consulta ao GLPI antes de desistir
TEMPO_MAXIMO_CONSULTA=10m
# teto de chamados por consulta (protege o GLPI de varreduras enormes)
MAX_CHAMADOS=5000
